{
  "name": "hey-ann",
  "version": "0.1.0",
  "private": true,
  "description": "A personal Kanban board that Claude and ChatGPT run for you over MCP.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --no-warnings --watch-path=src src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --no-warnings src/server/start.ts",
    "serve": "node --no-warnings src/server/index.ts",
    "password": "node --no-warnings scripts/password.ts",
    "mcp": "node --no-warnings src/mcp/stdio.ts",
    "seed": "node --no-warnings scripts/seed.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --no-warnings --test tests/*.test.ts",
    "phone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-phone.ps1"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chrono-node": "^2.10.3",
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.74.0",
    "marked": "^18.2.1",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "uqr": "^0.1.2",
    "vite": "^8.3.8",
    "wouter": "^3.13.0"
  }
}
